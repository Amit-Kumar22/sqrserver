# MongoDB Connection (Replace with your MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/squareserver?retryWrites=true&w=majority

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Email Configuration - Hostinger SMTP
EMAIL_SERVICE=smtp
EMAIL_USER=info@squareserver.in
EMAIL_PASS=your_email_password_here
EMAIL_FROM=info@squareserver.in

# Hostinger SMTP Settings (SSL Configuration)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Contact Email Configuration
CONTACT_EMAIL_RECEIVER=info@squareserver.in


# Next.js
NEXTAUTH_URL=http://localhost:3000

# Admin Credentials (Initial Setup)
ADMIN_EMAIL=admin@squareserver.in
ADMIN_PASSWORD=admin123
