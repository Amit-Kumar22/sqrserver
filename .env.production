# Production Environment Variables
# Copy this to .env.local on your production server

# MongoDB Connection - Using local MongoDB for development
# For production, replace with your MongoDB Atlas URI
MONGODB_URI=mongodb://squareserver_user:CHANGE_ME@127.0.0.1:27017/squareserver_db?authSource=admin

# JWT Secret (Generate a new secure random string - do not reuse this placeholder)
JWT_SECRET=CHANGE_ME_SquareServer_SuperSecure_JWT_Key_ChangeInProduction

# Email Configuration - Hostinger SMTP
EMAIL_SERVICE=smtp
EMAIL_USER=info@squareserver.in
EMAIL_PASS=CHANGE_ME
EMAIL_FROM=info@squareserver.in

# Hostinger SMTP Settings (SSL Configuration)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Contact Email Configuration
CONTACT_EMAIL_RECEIVER=info@squareserver.in

# Next.js (Update this to your production domain)
NEXTAUTH_URL=http://localhost:3000

# Admin Credentials (Change these for production)
ADMIN_EMAIL=admin@squareserver.in
ADMIN_PASSWORD=CHANGE_ME

# IMPORTANT: Replace all CHANGE_ME values (EMAIL_PASS, JWT_SECRET, DB URI, ADMIN_PASSWORD) with your own secure values and keep them out of version control.
