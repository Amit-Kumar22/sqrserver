export async function GET(
  request: NextRequest,
  { params }: { params: { id: string } }
) {
  try {
    const content = mockResearch.find(r => r._id === params.id);
    
    if (!content) {
      return NextResponse.json(
        { error: 'Research content not found' },
        { status: 404 }
      );
    }

    return NextResponse.json({ content });
  } catch (error) {
    console.error('Get research content error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

export async function PUT(
  request: NextRequest,
  { params }: { params: { id: string } }
) {
  try {
    const data = await request.json();
    const contentIndex = mockResearch.findIndex(r => r._id === params.id);
    
    if (contentIndex === -1) {
      return NextResponse.json(
        { error: 'Research content not found' },
        { status: 404 }
      );
    }

    // Update the content in mock data
    const updatedContent = {
      ...mockResearch[contentIndex],
      ...data,
      updatedAt: new Date().toISOString(),
    };
    
    // In a real app, this would be saved to database
    // For demo, we'll just return success
    
    return NextResponse.json({
      message: 'Research content updated successfully',
      content: updatedContent,
    });
  } catch (error) {
    console.error('Update research content error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}

export async function DELETE(
  request: NextRequest,
  { params }: { params: { id: string } }
) {
  try {
    const contentIndex = mockResearch.findIndex(r => r._id === params.id);
    
    if (contentIndex === -1) {
      return NextResponse.json(
        { error: 'Research content not found' },
        { status: 404 }
      );
    }

    // In a real app, this would be deleted from database
    // For demo, we'll just return success
    
    return NextResponse.json({
      message: 'Research content deleted successfully',
    });
  } catch (error) {
    console.error('Delete research content error:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}